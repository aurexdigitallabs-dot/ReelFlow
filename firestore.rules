rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if logged-in user document has super or super_admin role
    function isSuperAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Check if logged-in user has admin or super role
    function isAdminOrSuper() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // =======================================================
    // 1. Users Collection: users/{uid}
    // =======================================================
    match /users/{userId} {
      // Any authenticated user can read user documents
      allow read: if isAuthenticated();
      
      // Users can create/update their own document on login, or Super Admins can manage any user
      allow create, update: if isOwner(userId) || isSuperAdmin();
      
      // Only Super Admins can delete user profiles
      allow delete: if isSuperAdmin();
    }

    // =======================================================
    // 2. Creators Collection: creators/{creatorId}
    // =======================================================
    match /creators/{creatorId} {
      // Authenticated users can read creator profiles
      allow read: if isAuthenticated();
      
      // Admins and Super Admins can add or update creators
      // Individual creators can update their profile image
      allow create: if isAuthenticated();
      allow update: if isAdminOrSuper() || (
        isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.creatorId == creatorId
      );
      
      // Only Admins / Super Admins can delete creators
      allow delete: if isAdminOrSuper();
    }

    // =======================================================
    // 3. Stores Collection: stores/{storeId}
    // =======================================================
    match /stores/{storeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin();
    }

    // =======================================================
    // 4. Categories Collection: categories/{catId}
    // =======================================================
    match /categories/{catId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdminOrSuper();
    }

    // =======================================================
    // 5. Content Items Collection: content/{contentId}
    // =======================================================
    match /content/{contentId} {
      allow read: if isAuthenticated();
      
      // Admins / Super Admins can create content
      allow create: if isAdminOrSuper();
      
      // Admins/Super Admins can edit any content; Creators can edit if assigned to creatorIds
      allow update: if isAdminOrSuper() || (
        isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.creatorId in resource.data.creatorIds
      );
      
      // Only Admins / Super Admins can delete content
      allow delete: if isAdminOrSuper();
    }

  }
}
